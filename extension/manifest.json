{
  "manifest_version": 3,
  "name": "Showdown Win-Prob Assistant",
  "version": "1.3",
  "description": "Live advisor overlay for Pokemon Showdown, powered by a local model bridge (run_assistant.bat).",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*", "https://*.psim.us/*"],
      "js": ["ws-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.pokemonshowdown.com/*", "https://*.psim.us/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
